# ============================================================================
#  Учётные данные GigaChat. Скопируйте этот файл в .env и заполните ОДНУ из схем.
#  НЕ коммитьте реальные ключи и сертификаты — .env в .gitignore.
#
#  Схема выбирается автоматически:
#    1) задан GIGACHAT_ACCESS_KEY            -> OAuth, внешний контур;
#    2) иначе заданы GIGACHAT_CERT + KEY     -> mTLS, внутренний контур.
# ============================================================================

# --- Схема 1: OAuth по ключу (внешний контур / интернет) ---------------------
# Ключ авторизации (base64 от "client_id:client_secret") из личного кабинета.
GIGACHAT_ACCESS_KEY=

# Scope: GIGACHAT_API_PERS (физлица) / GIGACHAT_API_B2B / GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Эндпоинт OAuth (нужен только для схемы по ключу).
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# --- Схема 2: mTLS по сертификату (внутренний контур) ------------------------
# Раскомментируйте и заполните, если НЕ используете GIGACHAT_ACCESS_KEY.
# Авторизация — клиентским сертификатом на TLS-уровне, токен не нужен.
# GIGACHAT_CERT=/app/lex_copilot/certs/CI04687135-DEV-ANALITIC_pem.txt
# GIGACHAT_KEY=/app/lex_copilot/certs/CI04687135-DEV-ANALITIC.key

# --- Общие настройки ---------------------------------------------------------
# Модель по умолчанию. Приоритетная — GigaChat-3-Ultra (если доступна на ключе),
# иначе для тестов используйте GigaChat-2-Max.
GIGACHAT_MODEL=GigaChat-3-Ultra

# Базовый URL API. Если НЕ задан — подставляется по выбранной схеме:
#   OAuth -> https://gigachat.devices.sberbank.ru/api/v1
#   mTLS  -> https://gigachat-ift.sberdevices.delta.sbrf.ru/v1
# Для внутреннего контура обычно явно задают внутренний эндпоинт:
# GIGACHAT_URL=https://gigachat-ift.sberdevices.delta.sbrf.ru/v1

# Проверка TLS-сертификата сервера. По умолчанию выключена (самоподписанный
# сертификат Сбера). Установите "1", если настроен корневой сертификат Минцифры.
GIGACHAT_VERIFY_SSL=0

GIGACHAT_TIMEOUT=120

# --- Модель для live-тестов (заведомо доступная) ---
DEVASSIST_TEST_MODEL=GigaChat-2-Max
